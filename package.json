{
  "name": "diploma-maker",
  "productName": "Diploma Maker",
  "version": "1.2.0",
  "description": "Offline diploma generator for camp sessions",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "vitest run",
    "smoke": "electron scripts/smoke.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "tesseract.js": "^5.1.0"
  },
  "build": {
    "appId": "ro.tabereapuseni.diplomamaker",
    "productName": "Diploma Maker",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "artifactName": "DiplomaMaker-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "CostinCJ",
        "repo": "diploma-maker"
      }
    ],
    "files": [
      "electron/**",
      "src/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "ocr-data",
        "to": "ocr-data"
      }
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**"
    ]
  }
}
